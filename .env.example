# ============================================================
# Apex Academy — environment configuration
# Copy this file to ".env" and fill in your real values.
# The app boots with sane defaults; only override what you need.
# ============================================================

# --- Server ---
PORT=3000
HOST=0.0.0.0
# NODE_ENV=production   # set on your production server

# --- Gemini AI ---
# Get a key from https://aistudio.google.com/apikey (starts with "AIza...").
GEMINI_API_KEY="AIza...your-key..."
# Optional: override the model. Default is a current, valid Flash model.
GEMINI_MODEL="gemini-2.5-flash"

# --- Admin account (created on first boot if none exists) ---
ADMIN_EMAIL="bahriddinhamidov057@gmail.com"
# Change this immediately after the first login.
ADMIN_PASSWORD="Apex@2026"

# --- Sessions (2FA / JWT) ---
# Use a long random string in production (e.g. `openssl rand -hex 48`).
JWT_SECRET=""
JWT_TTL_SECONDS=28800       # 8 hours
OTP_TTL_SECONDS=300         # 5 minutes
OTP_MAX_ATTEMPTS=5

# --- Email (2FA codes) ---
# "console" prints the code to the server log (good for local testing).
# "smtp" sends real email (requires the SMTP_* values + `npm install nodemailer`).
MAIL_TRANSPORT="console"
MAIL_FROM="Apex Academy <no-reply@apexacademy.uz>"
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
# SMTP_USER=your@gmail.com, SMTP_PASS=<Gmail App Password>
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""

# --- Database ---
# Leave empty to use the zero-config JSON file store (data/db.json).
# Set to enable PostgreSQL (requires `npm install pg`):
# DATABASE_URL="postgres://user:password@localhost:5432/apex_academy"
DATABASE_URL=""

# --- Uploads ---
UPLOAD_MAX_BYTES=157286400  # 150 MB
